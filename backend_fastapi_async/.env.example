# --- Application -----------------------------------------------------------
APP_NAME=Filebox
ENVIRONMENT=development
DEBUG=true

# 32+ random bytes. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-32-bytes-min
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Database ---------------------------------------------------------------
# Local dev (SQLite):  sqlite+aiosqlite:///./filebox.db
# Docker (Postgres):   postgresql+asyncpg://filebox:filebox@postgres:5432/filebox
DATABASE_URL=sqlite+aiosqlite:///./filebox.db

# --- Object storage ---------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=2147483648
DEFAULT_STORAGE_LIMIT_BYTES=16106127360

# --- CORS (Expo dev servers) ------------------------------------------------
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8080,http://localhost:3000,http://localhost:19000

# --- Redis (cache, rate limit, Celery broker) -------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=30
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Event bus: noop | redis-streams | kafka --------------------------------
EVENT_BUS=redis-streams
EVENT_STREAM=filebox:events
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=filebox.events

# --- Limits / misc ----------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
PUBLIC_SHARE_BASE_URL=http://localhost:4000/s
THUMBNAIL_SIZE=256
TRASH_RETENTION_DAYS=30
